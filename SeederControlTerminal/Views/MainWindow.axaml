<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SeederControlTerminal.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:SeederControlTerminal.Models"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
        x:Class="SeederControlTerminal.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Терминал"
        Width="750" Height="550"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="320, *">

        <!-- ЛЕВАЯ ЧАСТЬ: Настройки отправки и приема -->
        <ScrollViewer Grid.Column="0">
            <StackPanel Margin="15" Spacing="15">

                <!-- БЛОК 1: ОТПРАВИТЕЛЬ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="🚀 Настройки ОТПРАВКИ" FontSize="15" FontWeight="Bold" Foreground="#1e90ff"/>
                    <Border Height="1" Background="#e0e0e0"/>

                    <TextBlock Text="Удаленный IP (куда шлем):"/>
                    <TextBox Text="{Binding IpAddress, Mode=TwoWay}"
                             IsEnabled="{Binding !IsSending}"/>

                    <TextBlock Text="Удаленный Порт:"/>
                    <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0"
                                   IsEnabled="{Binding !IsSending}"/>

                    <TextBlock Text="Текст сообщения:"/>
                    <TextBox Text="{Binding MessageText, Mode=TwoWay}" Watermark="Payload..."
                             IsEnabled="{Binding !IsSending}"/>

                    <Button Content="Отправить по TCP"
                            Command="{Binding SendMessageCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="#1e90ff" Foreground="White" Padding="10" FontWeight="Bold"/>
                </StackPanel>

                <Control Height="10"/>

                <!-- БЛОК 2: ПРИЕМНИК -->
                <StackPanel Spacing="8">
                    <TextBlock Text="📥 Настройки ПРИЕМНИКА" FontSize="15" FontWeight="Bold" Foreground="#2ed573"/>
                    <Border Height="1" Background="#e0e0e0"/>

                    <TextBlock Text="Локальный IP (0.0.0.0 - все):"/>
                    <TextBox Text="{Binding ReceiverIp, Mode=TwoWay}"
                             IsEnabled="{Binding IsReceiverFieldsEnabled}"/>

                    <TextBlock Text="Порт для прослушивания:"/>
                    <NumericUpDown Value="{Binding ReceiverPort}"
                                   Minimum="1" Maximum="65535" FormatString="0"
                                   IsEnabled="{Binding IsReceiverFieldsEnabled}"/>

                    <Button Content="{Binding ReceiverButtonText}"
                            Command="{Binding ToggleReceiverCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Background="{Binding ReceiverButtonColor}" Foreground="White"
                            Padding="10" FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ПРАВАЯ ЧАСТЬ: Монитор обмена (Лог) -->
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *" Margin="15">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0"
                           Text="Монитор обмена данными (События)"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#2f3542"/>

                <Button Grid.Column="1"
                        Command="{Binding ClearLogCommand}"
                        Content="Очистить лог"
                        Background="Transparent"
                        Foreground="#747d8c"
                        FontSize="12"
                        FontWeight="Medium"
                        Padding="8,4"
                        VerticalAlignment="Center">

                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#f1f2f6"/>
                            <Setter Property="Foreground" Value="#ff4757"/> 
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="#f1f2f6" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                    <!-- Графический светодиод (Ellipse), привязанный к StatusColor -->
                    <Ellipse Width="16" Height="16" Fill="{Binding StatusColor}">
                        <Ellipse.Transitions>
                            <!-- Плавное мигание/смена цвета интерфейса силами GPU (OpenGL) -->
                            <Transitions>
                                <BrushTransition Property="Ellipse.Fill" Duration="0:0:0.3"/>
                            </Transitions>
                        </Ellipse.Transitions>
                    </Ellipse>

                    <!-- Текст текущего статуса -->
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="Medium" VerticalAlignment="Center" Foreground="#2f3542"/>

                    <Viewbox Width="32" Height="32" IsVisible="{Binding IsSending}" Margin="20,0,0,0">
                        <Canvas Width="32" Height="32">

                            <!-- Центральная точка (ядро сокета) -->
                            <Ellipse Width="6" Height="6" Fill="#1e90ff" Canvas.Left="13" Canvas.Top="13"/>

                            <!-- Внешнее пульсирующее кольцо радара -->
                            <Ellipse Width="32" Height="32" Canvas.Left="0" Canvas.Top="0"
                                     Stroke="#1e90ff" StrokeThickness="2" RenderTransformOrigin="50%,50%">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <!-- Бесконечный цикл расширения и затухания кольца силами GPU (OpenGL) -->
                                            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="ScaleTransform.ScaleX" Value="0.1"/>
                                                    <Setter Property="ScaleTransform.ScaleY" Value="0.1"/>
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                                    <Setter Property="Opacity" Value="0.0"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>

                        </Canvas>
                    </Viewbox>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Background="#f8f9fa">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox Name="LogListBox" ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntry">
                                <Grid ColumnDefinitions="Auto, *">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Time}"
                                               Foreground="#a4b0be"
                                               FontFamily="Courier New"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Top"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               Foreground="{Binding Color}"
                                               FontFamily="Courier New"
                                               FontWeight="Medium"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>